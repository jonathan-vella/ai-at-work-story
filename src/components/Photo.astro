---
const { src, alt, caption, width, height } = Astro.props;
const imageSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${src.replace(/^\//, "")}`;
---
<figure class="photo">
  <img src={imageSrc} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>
