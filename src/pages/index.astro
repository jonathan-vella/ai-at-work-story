---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Content, frontmatter } from "../../story.mdx";
import "../styles/site.css";
import About from "../components/About.astro";
import Band from "../components/Band.astro";
import Chapter from "../components/Chapter.astro";
import Claim from "../components/Claim.astro";
import Diagram from "../components/Diagram.astro";
import Draft from "../components/Draft.astro";
import Fact from "../components/Fact.astro";
import FirstStep from "../components/FirstStep.astro";
import FirstSteps from "../components/FirstSteps.astro";
import ForYou from "../components/ForYou.astro";
import Gates from "../components/Gates.astro";
import Hero from "../components/Hero.astro";
import Journey from "../components/Journey.astro";
import Main from "../components/Main.astro";
import Phase from "../components/Phase.astro";
import Photo from "../components/Photo.astro";
import Practice from "../components/Practice.astro";
import PracticeStage from "../components/PracticeStage.astro";
import PracticeStages from "../components/PracticeStages.astro";
import Scope from "../components/Scope.astro";
import SectionNav from "../components/SectionNav.astro";
import SiteBar from "../components/SiteBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Signature from "../components/Signature.astro";
import SkillStage from "../components/SkillStage.astro";
import SkillsRoadmap from "../components/SkillsRoadmap.astro";
import Split from "../components/Split.astro";
import Stage from "../components/Stage.astro";
import Stat from "../components/Stat.astro";
import Stats from "../components/Stats.astro";
import Step from "../components/Step.astro";
import Steps from "../components/Steps.astro";
import Versus from "../components/Versus.astro";
import Workflow from "../components/Workflow.astro";
import YourWords from "../components/YourWords.astro";

const components = {
  About, Band, Chapter, Claim, Diagram, Draft, Fact, FirstStep, FirstSteps, ForYou, Gates, Hero, Journey, Main,
  Phase, Photo, Practice, PracticeStage, PracticeStages, Scope, SiteBar, SiteFooter,
  SectionNav, Signature, SkillStage, SkillsRoadmap, Split, Stage, Stat, Stats, Step, Steps, Versus, Workflow, YourWords,
};

const unresolved = readFileSync(join(process.cwd(), "story.mdx"), "utf8").match(
  /\[(?:Your words|Draft line)[^\]]*\]/g,
);
if (import.meta.env.PROD && unresolved) {
  throw new Error(
    `story.mdx still has ${unresolved.length} unresolved marker(s): ${unresolved.join(", ")}. Replace each with your final text and remove its component before building.`,
  );
}

const { lang, siteName, pageTitle, description, shareDescription, shareImagePath, shareImageAlt } = frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = new URL(`${base}/`, Astro.site).href;
const shareImage = new URL(`${base}/${shareImagePath}`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <Content components={components} />
  </body>
</html>
