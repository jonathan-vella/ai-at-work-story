---
import MarkdownIt from "markdown-it";
import storyContent from "../../story.md?raw";
import "../styles/site.css";

const storySource = storyContent
  .replace(/^# Story draft\s*\r?\n/, "")
  .trim();
const markdown = new MarkdownIt({ html: false, linkify: true });

const visualByHeading = {
  "It started in 2013": {
    file: "role-evolution.svg",
    width: 420,
    height: 962,
    alt: "A story that starts in 2013 with a move from on-premises to cloud-first work, then three stages: Use (May 2025), Build (late 2025 to 2026, APEX: AI prepares, humans decide) and Scale (past nine months, webinars and bootcamps, with others delivering it too). Guardrails apply throughout: verify every output and bring in specialists for decisions beyond my expertise. Infrastructure expertise stays the foundation.",
    caption:
      "Use AI, build a workflow, share it. Guardrails apply at every stage, and infrastructure expertise stays the foundation.",
  },
  "Tools I use": {
    file: "tools-i-use.svg",
    width: 420,
    height: 240,
    decorative: true,
  },
  "One engagement, in numbers": {
    file: "apex-engagement-timeline.svg",
    width: 420,
    height: 1352,
    alt: "An anonymized APEX engagement with separate timings: under 18 hours to completed Terraform, about six hands-on hours, and deployment on day three. Customer feedback is self-reported.",
    caption:
      "One anonymized customer engagement with three separate timings: under 18 hours elapsed to completed Terraform, about six hands-on hours, and a successful deployment on day three. Customer-reported experience, not a controlled benchmark.",
  },
  "What I still own": {
    file: "human-ai-specialist-workflow.svg",
    width: 420,
    height: 1238,
    alt: "A six-step workflow: discover business needs, develop the architecture, use AI, check outputs, consult specialists when needed, and leave production approval to qualified people.",
    caption:
      "AI assists, but checking, specialist input when needed, and production approval are human steps.",
  },
};

const configuredBaseUrl = import.meta.env.BASE_URL;
const baseUrl = configuredBaseUrl.endsWith("/")
  ? configuredBaseUrl
  : `${configuredBaseUrl}/`;
const sections = storySource
  .split(/(?=^##\s)/m)
  .map((source) => source.trim())
  .filter(Boolean)
  .map((source) => {
    const heading = source.match(/^##\s+(.+)$/m)?.[1] ?? "";
    const visual = visualByHeading[heading];

    return {
      heading,
      html: markdown
        .render(source)
        .replaceAll("<p><strong>For you:</strong>", '<p class="for-you"><strong>For you:</strong>'),
      visual: visual
        ? {
            ...visual,
            src: `${baseUrl}images/${visual.file}`,
          }
        : undefined,
    };
  });

const pageTitle = "Practice the change";
const pageSubtitle = "An infra architect's journey with AI";
const pageDescription =
  "A personal account of how AI tools helped an infrastructure architect extend his work, build repeatable workflows and share them with others.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#14213d" />
    <title>{pageTitle}: {pageSubtitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={baseUrl}>AI at work</a>
      <span class="site-note">A personal story</span>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <h1 id="page-title">{pageTitle}</h1>
        <p class="subtitle">{pageSubtitle}</p>
        <p class="disclaimer">Not official Microsoft guidance or endorsement.</p>
      </section>

      <article class="story">
        {
          sections.map((section) => (
            <section class="story-section">
              <div class="prose" set:html={section.html} />
              {section.visual?.decorative ? (
                <div class="visual visual--tools">
                  <img
                    src={section.visual.src}
                    width={section.visual.width}
                    height={section.visual.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : section.visual ? (
                <figure class="visual">
                  <img
                    src={section.visual.src}
                    width={section.visual.width}
                    height={section.visual.height}
                    alt={section.visual.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{section.visual.caption}</figcaption>
                </figure>
              ) : null}
            </section>
          ))
        }
      </article>
    </main>

    <footer class="site-footer">
      <p>Personal account by Jonathan Vella.</p>
    </footer>
  </body>
</html>
